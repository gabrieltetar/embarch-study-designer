    "markers": [
     {
      "name": "a",
      "t_ms": 1000,
      "u_ms": null
     },
     {
      "name": "b",
      "t_ms": 1250,
      "u_ms": 0.1
     }
    ],
    "window": {
     "from_marker": "a",
     "to_marker": "b"
    }
   },
   "expect": {
    "value": 250.0,
