{
 "reducer": "interval",
 "cases": [
  {
   "name": "rss of both stamps and the clock",
   "input": {
    "unit": "1",
    "clock_u_ms": 0.4,
    "markers": [
     {
      "name": "a",
      "t_ms": 1000,
      "u_ms": 0.3
     },
     {
      "name": "b",
      "t_ms": 1250,
      "u_ms": 0.0
     }
    ],
    "window": {
